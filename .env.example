# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///data/jobs.db
LOG_LEVEL=INFO

# Adzuna API (free account at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LLM for drafting (step 5). "gemini" (free tier) or "anthropic" (paid)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
